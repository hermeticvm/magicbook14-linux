        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "dh.tray"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "dh.power"
        },
        {
          "id": "omarchy.monitor"
        },
        {
